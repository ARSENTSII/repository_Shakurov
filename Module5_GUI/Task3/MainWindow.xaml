<!-- Окно списка задач. x:Class связывает разметку с классом MainWindow в C# (namespace Task3) -->
<Window x:Class="Task3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <!-- Главный контейнер с отступом 10 пикселей от краёв окна -->
    <Grid Margin="10">
        <!-- Три строки сетки:
             Auto — по высоте содержимого, * — всё оставшееся место.
             Нужная строка выбирается атрибутом Grid.Row (нумерация с нуля) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- строка 0: поле ввода и кнопка «Добавить» -->
            <RowDefinition Height="*"/>
            <!-- строка 1: список задач (растягивается) -->
            <RowDefinition Height="Auto"/>
            <!-- строка 2: кнопка «Удалить» -->
        </Grid.RowDefinitions>

        <!-- Строка 0: ввод новой задачи.
             DockPanel прижимает кнопку вправо, а поле ввода занимает всё остальное место.
             Margin снизу (10) отделяет строку ввода от списка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <!-- Кнопка «Добавить». Padding — внутренний отступ (кнопка шире и выше текста),
                 Margin слева (10) — зазор между кнопкой и полем.
                 Click связывает нажатие с методом btnAdd_Click -->
            <Button x:Name="btnAdd" Content="Добавить" DockPanel.Dock="Right"
        Padding="12,3" Margin="10,0,0,0" Click="btnAdd_Click"/>
            <!-- Поле ввода текста задачи.
                 KeyDown вызывает метод txtNewTask_KeyDown при нажатии клавиши
                 (в нём проверяется Enter) -->
            <TextBox x:Name="txtNewTask" FontSize="14" KeyDown="txtNewTask_KeyDown"/>
        </DockPanel>

        <!-- Строка 1: список задач.
             Сами элементы в XAML не перечислены: в C# списку задаётся ItemsSource,
             а внешний вид каждой задачи описывает шаблон ниже -->
        <ListBox x:Name="listTasks" Grid.Row="1" FontSize="14">
            <ListBox.ItemTemplate>
                <!-- DataTemplate — шаблон одной задачи; применяется ко всем элементам списка -->
                <DataTemplate>
                    <!-- Флажок «выполнена». Binding связывает IsChecked со свойством IsDone объекта TodoItem.
                         Mode=TwoWay — связь двусторонняя: галочка меняет IsDone, и наоборот -->
                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="2">
                        <!-- Подпись флажка: текст задачи из свойства Title -->
                        <TextBlock Text="{Binding Title}">
                            <!-- Стиль для зачёркивания выполненных задач -->
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- Правило: если IsDone равно True, применить настройки ниже.
                                             Когда галочку снимают, текст возвращается к обычному виду -->
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <!-- Зачёркнутый текст серого цвета -->
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Строка 2: кнопка удаления выбранной задачи.
             HorizontalAlignment="Left" — прижата влево, чтобы не растягиваться на всю ширину.
             Margin сверху (10) — отступ от списка.
             Click связывает нажатие с методом btnDelete_Click -->
        <Button x:Name="btnDelete" Grid.Row="2" Content="Удалить выбранную"
        HorizontalAlignment="Left" Padding="12,3" Margin="0,10,0,0"
        Click="btnDelete_Click"/>
    </Grid>
</Window>