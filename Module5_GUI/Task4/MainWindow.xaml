<Window x:Class="Task4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="btnOpen" Content="Открыть изображение" Padding="12,3"
        Click="btnOpen_Click"/>

            <TextBlock Text="Масштаб:" VerticalAlignment="Center" Margin="20,0,5,0"/>

            <Slider x:Name="zoomSlider" Minimum="0.1" Maximum="5" Value="1"
        Width="200" VerticalAlignment="Center"
        ValueChanged="zoomSlider_ValueChanged"/>

            <TextBlock x:Name="txtZoom" Text="100%" Width="50"
                   VerticalAlignment="Center" Margin="5,0,0,0"/>

            <Button x:Name="btnReset" Content="Сбросить" Padding="12,3"
        Click="btnReset_Click"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="10,0,10,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="WhiteSmoke">
                <Image x:Name="imgView" Stretch="None"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
