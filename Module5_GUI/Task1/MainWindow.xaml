<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Button Content="Нарисовать линию" HorizontalAlignment="Left" Margin="228,61,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="Нарисовать круг" HorizontalAlignment="Center" Margin="0,61,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.02,0.533" Click="Button_Click_1"/>
        <Button Content="Нарисовать квадрат" HorizontalAlignment="Left" Margin="469,61,0,0" VerticalAlignment="Top" Click="Button_Click_2"/>
        <Button Content="Очистить холст" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Click="Button_Click_3"/>
        <Border BorderBrush="Black" BorderThickness="2" Margin="159,108,159,10">
            <Canvas x:Name="canvas" Background="White" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
