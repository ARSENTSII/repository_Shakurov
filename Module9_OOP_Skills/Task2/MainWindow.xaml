<Window x:Class="Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2"
        mc:Ignorable="d"
        Title="Управление проектами" Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Отчёты" Width="100" HorizontalAlignment="Left"
                Margin="10,10,0,0" Click="Reports_Click"/>

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="Сотрудники">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgEmployees" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Добавить" Width="100" Margin="0,0,10,0" Click="AddEmployee_Click"/>
                        <Button Content="Изменить" Width="100" Margin="0,0,10,0" Click="EditEmployee_Click"/>
                        <Button Content="Удалить" Width="100" Click="DeleteEmployee_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Проекты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgProjects" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Добавить" Width="100" Margin="0,0,10,0" Click="AddProject_Click"/>
                        <Button Content="Изменить" Width="100" Margin="0,0,10,0" Click="EditProject_Click"/>
                        <Button Content="Удалить" Width="100" Click="DeleteProject_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Задачи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgTasks" Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDueSoonNow}" Value="True">
                                        <Setter Property="Background" Value="#FFF3CD"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="*"/>
                            <DataGridTextColumn Header="Исполнитель" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="90"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding PriorityText}" Width="85"/>
                            <DataGridTemplateColumn Header="Прогресс" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding Progress, Mode=OneWay}" Height="18"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Добавить" Width="100" Margin="0,0,10,0" Click="AddTask_Click"/>
                        <Button Content="Изменить" Width="100" Margin="0,0,10,0" Click="EditTask_Click"/>
                        <Button Content="Удалить" Width="100" Click="DeleteTask_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="Gray"
                               Text="Красным выделены просроченные задачи, жёлтым — со сроком в ближайшие 3 дня"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>