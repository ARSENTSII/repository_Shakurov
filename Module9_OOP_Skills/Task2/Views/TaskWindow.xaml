<Window x:Class="Task2.Views.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Название"/>
        <TextBox x:Name="txtTitle" Margin="0,3,0,8"/>

        <TextBlock Text="Описание"/>
        <TextBox x:Name="txtDescription" Height="50" TextWrapping="Wrap"
                 AcceptsReturn="True" Margin="0,3,0,8"/>

        <TextBlock Text="Проект"/>
        <ComboBox x:Name="cbProject" DisplayMemberPath="Name" Margin="0,3,0,8"/>

        <TextBlock Text="Исполнитель"/>
        <ComboBox x:Name="cbEmployee" DisplayMemberPath="FullName" Margin="0,3,0,8"/>

        <TextBlock Text="Статус"/>
        <ComboBox x:Name="cbStatus" Margin="0,3,0,8"/>

        <TextBlock Text="Приоритет"/>
        <ComboBox x:Name="cbPriority" Margin="0,3,0,8"/>

        <TextBlock Text="Прогресс"/>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
            <Slider x:Name="sliderProgress" Minimum="0" Maximum="100"
                    Width="270" TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding Value, ElementName=sliderProgress, StringFormat={}{0:0}%}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="Срок выполнения"/>
        <DatePicker x:Name="dpDeadline" Margin="0,3,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="90" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
