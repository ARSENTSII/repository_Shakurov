<Window x:Class="Task2.Views.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2.Views"
        mc:Ignorable="d"
        Title="ProjectWindow" Height="450" Width="800">
    <StackPanel Margin="15">
        <TextBlock Text="Название"/>
        <TextBox x:Name="txtName" Margin="0,3,0,10"/>

        <TextBlock Text="Описание"/>
        <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap"
                 AcceptsReturn="True" Margin="0,3,0,10"/>

        <TextBlock Text="Дата начала"/>
        <DatePicker x:Name="dpStart" Margin="0,3,0,10"/>

        <TextBlock Text="Дата окончания"/>
        <DatePicker x:Name="dpEnd" Margin="0,3,0,10"/>

        <TextBlock Text="Статус"/>
        <ComboBox x:Name="cbStatus" Margin="0,3,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="90" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
