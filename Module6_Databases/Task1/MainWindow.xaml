<Window x:Class="Task1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task1"
        mc:Ignorable="d"
        Title="Учет сотрудников" Height="450" Width="800">
    <Grid x:Name="MainGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <DataGrid x:Name="EmployeesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="EmployeesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="150"/>
                <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="txtName" Width="160" Margin="5,0,5,5" ToolTip="ФИО"/>
            <TextBox x:Name="txtPosition" Width="110" Margin="0,0,5,5" ToolTip="Должность"/>
            <TextBox x:Name="txtDept" Width="110" Margin="0,0,5,5" ToolTip="Отдел"/>
            <TextBox x:Name="txtSalary" Width="80" Margin="0,0,10,5" ToolTip="Зарплата"/>
            <Button Content="Добавить"  Width="80" Margin="0,0,5,5" Click="Add_Click"/>
            <Button Content="Изменить"  Width="80" Margin="0,0,5,5" Click="Edit_Click"/>
            <Button Content="Удалить"  Width="80" Margin="0,0,5,5" Click="Delete_Click"/>
        </StackPanel>
             
     </Grid>
</Window>
