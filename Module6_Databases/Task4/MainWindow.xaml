<Window x:Class="Task4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task4"
        mc:Ignorable="d"
        Title="Учет финансов" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="FinanceGrid" Grid.Row="0" IsReadOnly="True"
                  AutoGenerateColumns="False" SelectionMode="Single"
                  SelectionChanged="FinanceGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="txtDescription" Width="220" Margin="0,0,5,0" ToolTip="Описание"/>
            <ComboBox x:Name="cmbType" Width="90" Margin="0,0,5,0">
                <ComboBoxItem Content="Доход" IsSelected="True"/>
                <ComboBoxItem Content="Расход"/>
            </ComboBox>
            <TextBox x:Name="txtAmount" Width="90" Margin="0,0,10,0" ToolTip="Сумма"/>
            <Button Content="Добавить" Click="Add_Click" Width="80" Margin="0,0,5,0"/>
            <Button Content="Изменить" Click="Edit_Click" Width="80" Margin="0,0,5,0"/>
            <Button Content="Удалить" Click="Delete_Click" Width="80"/>
        </StackPanel>

        <TextBlock x:Name="txtBalance" Grid.Row="2" Margin="0,10,0,0"
                   FontSize="16" FontWeight="Bold"/>
    </Grid>
</Window>
