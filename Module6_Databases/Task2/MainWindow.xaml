<Window x:Class="Task2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2"
        mc:Ignorable="d"
        Title="Учет задач" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="TasksGrid" Grid.Row="0" IsReadOnly="True"
                  AutoGenerateColumns="False" SelectionMode="Single"
                  SelectionChanged="TasksGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="txtTitle" Width="160" Margin="0,0,5,0" ToolTip="Название"/>
            <TextBox x:Name="txtDescription" Width="200" Margin="0,0,5,0" ToolTip="Описание"/>
            <ComboBox x:Name="cmbStatus" Width="110" Margin="0,0,10,0">
                <ComboBoxItem Content="Новая" IsSelected="True"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Выполнена"/>
            </ComboBox>
            <Button Content="Добавить" Click="Add_Click" Width="80" Margin="0,0,5,0"/>
            <Button Content="Изменить" Click="Edit_Click" Width="80" Margin="0,0,5,0"/>
            <Button Content="Удалить" Click="Delete_Click" Width="80"/>
        </StackPanel>
        
    </Grid>
</Window>
